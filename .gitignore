# Byte-compiled / caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Packaging
*.egg-info/
build/
dist/

# Environments
.venv/
venv/
env/

# Downloaded checkpoints, converted shards, and optimizer state.
# Shards are regenerated by runners.export_decoder_shards; a single model can
# be 60+ GiB, so nothing under here belongs in version control.
models/
shards-*/
*.safetensors
*.bin
*.gguf

# Trained adapter checkpoints and run logs. Adapters are small but are build
# artifacts; publish them to a model hub rather than committing them.
*.pt
*.pth
*.log

# Checkpoint manifests fetched from the Hub by planner.fetch_manifest.
# Derived cache, regenerated on demand, several MiB per model.
configs/

# Benchmark output that is regenerated on each run
results/trace.json
